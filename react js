## 8. Spotify Now Playing

```html
<!DOCTYPE html>
<html>
<head>
    <title>Now Playing</title>
</head>
<body>

<h2>
Now Playing:
<span id="song-title">Believer</span>
</h2>

<button>Change Song</button>

<script>

const songs = [
    "Believer",
    "Perfect",
    "Shape of You",
    "Kesariya"
];

let index = 0;

const title = document.getElementById("song-title");
const button = document.querySelector("button");

button.addEventListener("click", function () {

    index++;

    if (index >= songs.length) {
        index = 0;
    }

    title.innerHTML = songs[index];

});

</script>

</body>
</html>
```

