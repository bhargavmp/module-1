## 9. Orders with Nested Arrays

```javascript
const orders = [
    {
        orderId: 101,
        items: [
            {
                itemName: "Pizza",
                price: 300
            },
            {
                itemName: "Burger",
                price: 150
            }
        ],
        delivery: {
            address: "Vadodara",
            status: "Delivered"
        }
    },
    {
        orderId: 102,
        items: [
            {
                itemName: "Pasta",
                price: 250
            },
            {
                itemName: "Cold Drink",
                price: 80
            }
        ],
        delivery: {
            address: "Ahmedabad",
            status: "Pending"
        }
    }
];

for (let order of orders) {

    let total = 0;

    for (let item of order.items) {
        total += item.price;
    }

    console.log(
        "Order ID:",
        order.orderId,
        "Total Price: ₹" + total
    );

}
```

